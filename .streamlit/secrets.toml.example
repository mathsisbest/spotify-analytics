# .streamlit/secrets.toml.example
# Copy this template into your Streamlit Community Cloud app settings under "Secrets"

SPOTIFY_CLIENT_ID = "your-spotify-client-id"
SPOTIFY_CLIENT_SECRET = "your-spotify-client-secret"
SPOTIFY_REFRESH_TOKEN = "your-spotify-refresh-token"

[gcp_service_account]
type = "service_account"
project_id = "spotify-analytics-76dd657e"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@spotify-analytics-76dd657e.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40spotify-analytics-76dd657e.iam.gserviceaccount.com"
